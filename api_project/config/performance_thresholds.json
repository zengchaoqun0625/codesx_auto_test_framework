{
  "enabled": true,
  "default_threshold_sec": 10.0,
  "rules": [
    {
      "name": "登录接口更严格阈值",
      "endpoint_contains": "/login",
      "threshold_sec": 10.0,
      "enabled": true
    },
    {
      "name": "支付接口阈值",
      "endpoint_contains": "/payment",
      "threshold_sec": 10.0,
      "enabled": true
    },
    {
      "name": "GET /api/mainChart",
      "endpoint_contains": "/api/mainChart",
      "method": "GET",
      "threshold_sec": 10.0,
      "enabled": true,
      "generated_by": "curl-to-testcase"
    },
    {
      "name": "GET /api/payOrder/list",
      "endpoint_contains": "/api/payOrder/list",
      "method": "GET",
      "threshold_sec": 10.0,
      "enabled": true,
      "generated_by": "curl-to-testcase"
    },
    {
      "name": "GET /api/payOrder/payCount",
      "endpoint_contains": "/api/payOrder/payCount",
      "method": "GET",
      "threshold_sec": 10.0,
      "enabled": true,
      "generated_by": "curl-to-testcase"
    },
    {
      "name": "GET /api/statistic/total/getQueryDate",
      "endpoint_contains": "/api/statistic/total/getQueryDate",
      "method": "GET",
      "threshold_sec": 10.0,
      "enabled": true,
      "generated_by": "curl-to-testcase"
    }
  ]
}
