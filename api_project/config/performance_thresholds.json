{
  "enabled": true,
  "default_threshold_sec": 5.0,
  "rules": [
    {
      "name": "登录接口更严格阈值",
      "endpoint_contains": "/login",
      "threshold_sec": 10.0,
      "enabled": true
    },
    {
      "name": "支付接口阈值",
      "endpoint_contains": "/payment",
      "threshold_sec": 10.0,
      "enabled": true
    },
    {
      "name": "GET /api/cashouts",
      "endpoint_contains": "/api/cashouts",
      "method": "GET",
      "threshold_sec": 5.0,
      "enabled": true,
      "generated_by": "curl-to-testcase"
    },
    {
      "name": "GET /api/codeItem",
      "endpoint_contains": "/api/codeItem",
      "method": "GET",
      "threshold_sec": 5.0,
      "enabled": true,
      "generated_by": "curl-to-testcase"
    },
    {
      "name": "POST /api/mchApply/mchList",
      "endpoint_contains": "/api/mchApply/mchList",
      "method": "POST",
      "threshold_sec": 5.0,
      "enabled": true,
      "generated_by": "curl-to-testcase"
    }
  ]
}
