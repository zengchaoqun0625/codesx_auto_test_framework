# ============================================================
# api_project/.env.example —— 敏感配置模板
# ------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env（Windows: copy .env.example .env）
#   2. 在 .env 中填写你的真实值（邮箱授权码、机器人 token 等）
#   3. .env 已被 .gitignore 忽略，不会提交到 git；本模板可正常提交
#
# 规则：所有配置项均为「环境变量优先，代码默认值兜底」，
#       不配置 .env 不影响框架启动；未配置 API_ITOKEN 的受鉴权接口会返回 401，
#       未配置通知凭据的渠道不会发送消息。
# ============================================================

# ==================== 邮件通知（严格三档） ====================
# always      = 全部成功/失败都发邮件
# only_failed = 只有失败才发邮件
# never       = 永远不发邮件
SEND_EMAIL=only_failed

# ==================== 敏感信息（环境变量读取，勿提交 git） ====================

# 接口鉴权 token：作为默认 iToken 注入，用例 JSON 也可通过 ${API_ITOKEN} 引用
# 请使用拥有全量回归接口权限的专用测试账号
API_ITOKEN=your_api_itoken
# 可选：接口依赖浏览器 Cookie 时填写；无依赖可留空
API_COOKIE=your_api_cookie

# 邮箱 SMTP 配置（QQ 邮箱用授权码，不是登录密码）
# QQ 邮箱授权码获取：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 开启 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your_account@qq.com
SMTP_PASSWORD=your_auth_code
SMTP_SUBJECT=自动化测试报告
# 收件人，多个用英文逗号分隔
SMTP_RECEIVERS=a@qq.com,b@qq.com

# 飞书机器人 webhook token
# 获取：飞书群 → 群设置 → 群机器人 → 添加自定义机器人 → 复制 webhook 中的 token
FEISHU_TOKEN=your_feishu_token

# 钉钉机器人 token 与加签 secret
# 获取：钉钉群 → 群设置 → 智能群助手 → 添加自定义机器人
# 安全设置选「加签」时填写 DINGDING_SECRET，无加签可留空
DINGDING_TOKEN=your_dingding_token
DINGDING_SECRET=your_dingding_secret

# 企业微信机器人 token
# 获取：企业微信群 → 群设置 → 添加群机器人 → 复制 webhook 中的 key 参数
WEIXIN_TOKEN=your_weixin_token

# 紧急联系人（电话通知使用，会展示在通知卡片/邮件中）
EMERGENCY_CONTACT=张三
EMERGENCY_PHONE=13800000000

# 电话通知 webhook（饭碗警告 https://fwalert.com）
# 获取：注册饭碗警告 → 转发规则 → 创建新规则 → 复制触发链接
PHONE_CALL_WEBHOOK=https://fwalert.com/your-webhook-url

# ==================== 可选配置（不配置则用代码默认值） ====================

# 消息通知总开关（飞书/钉钉/企微/电话）：always / only_failed / never
# 默认 only_failed；设为 never 时机器人和电话通知都不发送
# PYTEST_NOTIFY_MODE=only_failed

# HTML 报告上传到 tmpfile.link：默认关闭，避免本地 pytest 产生外部上传。
# 仅在明确需要公网临时链接时设为 true。
# UPLOAD_TEST_REPORT=false

# Allure 公网地址（花生壳内网穿透域名，用于外网访问报告）
# 不配置时默认自动生成局域网地址 http://本机IP:9797
# ALLURE_URL=https://xxxx.vicp.fun

# Allure 服务端口（默认 9797）
# ALLURE_PORT=9797

# 测试执行人（通知中显示，默认取 git user.name）
# TEST_EXECUTOR=张三

# 请求默认超时（秒，默认 10）
# API_TIMEOUT=10

# TLS 证书校验：默认 true。仅测试环境使用自签名证书时才设为 false。
# API_VERIFY_TLS=true

# 机器人与电话通知的网络策略：默认校验证书，超时 10 秒。
# NOTIFICATION_VERIFY_TLS=true
# NOTIFICATION_TIMEOUT=10

# 网络代理开关：默认直连（忽略系统/环境变量代理，避免本地代理未启动时
# 报 Connection aborted / FileNotFoundError / SSL EOF）
# 需要走代理访问外网接口时设为 true，将恢复读取 HTTP_PROXY/HTTPS_PROXY
# PROXY_ENABLED=false

# 按模块/接口筛选执行（RUN_MODULE=list 查看所有可选值）
# RUN_MODULE=查询模块,jqb_payment_api

# ==================== 定时调度器（可选） ====================
# 总开关：true=允许 run_scheduler.py 启动调度，false=禁用（默认）
# 依赖：pip install "apscheduler>=3.10,<4"（已写入 requirements.txt）
# 任务配置：api_project/config/scheduler_jobs.json（cron 表达式 + env 覆盖，每个任务可独立启停）
# 用法：python run_scheduler.py --dry-run 预览；--force 临时强制启动
SCHEDULER_ENABLED=false
# 任务配置文件路径覆盖（默认 api_project/config/scheduler_jobs.json）
# SCHEDULER_JOBS_FILE=api_project/config/scheduler_jobs.json

# ==================== 接口性能基准（可选） ====================
# 配置文件：api_project/config/performance_thresholds.json
# enabled=true 后才会沉淀接口响应耗时、生成 performance_report.html，并将超阈值接口加入机器人通知。
# 默认阈值与接口专属阈值均以秒为单位；规则按 JSON 数组顺序优先匹配。
# 注意：该功能使用 HTTP 响应耗时（requests.Response.elapsed），不含 pytest fixture / 断言开销。
