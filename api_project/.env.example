# ============================================================
# api_project/.env.example —— 本地/CI 配置模板（可安全提交）
# ============================================================
# 1. 复制为 api_project/.env；.env 已被 Git 忽略，绝不提交。
# 2. 所有真实 token、Cookie、密码、webhook 只填入 .env 或 CI 密钥。
# 3. 空值表示不配置；不要把示例占位文本当作真实配置提交。
# 4. 命令行/CI 环境变量优先于 .env。

# ==================== 接口环境与认证 ====================
# 域名优先级：--api-host > API_HOST > API_ENV 对应的 host_env > 历史配置。
API_ENV=test
TEST_API_HOST=https://test-api.example.com
PRO_API_HOST=https://api.example.com
# 临时或 CI 覆盖；留空时使用 API_ENV 对应的域名。
API_HOST=

# API_TOKEN 优先于兼容字段 API_ITOKEN；二选一即可。
API_TOKEN=
API_ITOKEN=
# 默认 iToken；Bearer 示例：Authorization / Bearer。
API_TOKEN_HEADER=iToken
API_TOKEN_PREFIX=
API_COOKIE=

# auth_profiles.json 中可引用的账号凭据（按实际角色增减）。
ADMIN_USERNAME=
ADMIN_PASSWORD=
MERCHANT_USERNAME=
MERCHANT_PASSWORD=

# 请求网络策略：生产/可信证书环境保持 true；自签名测试环境才设 false。
API_TIMEOUT=10
API_VERIFY_TLS=true
# 默认直连，不读取系统 HTTP(S)_PROXY；确需代理时设为 true。
PROXY_ENABLED=false

# ==================== 执行与报告 ====================
# 可用模块/Allure 预设用逗号分隔；留空为全量。RUN_MODULE=list 仅查看可用项。
RUN_MODULE=
TEST_EXECUTOR=

# Allure 服务默认不自动启动；报告 HTML 和压缩包仍会生成。
AUTO_START_ALLURE=false
ALLURE_PORT=9797
# 本地或公网报告地址；留空时本地地址自动按本机 IP 和端口生成。
ALLURE_URL=
ALLURE_URLS=
# 保留最近 N 份 allure_reports 时间戳备份和 api_project/report 内的 Allure ZIP。
# 必须为正整数；默认 3。
ALLURE_REPORT_KEEP=3
# 仅明确需要临时公网 HTML 链接时设为 true。
UPLOAD_TEST_REPORT=false
# 通知内最多展示的成功用例数。
PASSED_DISPLAY_LIMIT=10

# ==================== 邮件通知 ====================
# always | only_failed | never
SEND_EMAIL=only_failed
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SUBJECT=接口自动化测试报告
# 多个收件人使用英文逗号分隔。
SMTP_RECEIVERS=

# ==================== 机器人与电话通知 ====================
# 总策略仅作用于飞书、钉钉、企业微信和电话：always | only_failed | never。
PYTEST_NOTIFY_MODE=only_failed
# 新项目模板默认关闭所有渠道；填写凭据后再按需显式开启。
FEISHU_ENABLED=false
DINGDING_ENABLED=false
WEIXIN_ENABLED=false
PHONE_CALL_ENABLED=false
FEISHU_TOKEN=
DINGDING_TOKEN=
# 未启用钉钉加签时留空。
DINGDING_SECRET=
WEIXIN_TOKEN=
# 电话 webhook 可能触发真实外呼，请仅在告警流程确认后配置和启用。
PHONE_CALL_WEBHOOK=
EMERGENCY_CONTACT=
EMERGENCY_PHONE=
# 机器人/电话网络策略。
NOTIFICATION_VERIFY_TLS=true
NOTIFICATION_TIMEOUT=10

# ==================== 定时调度 ====================
# 必须同时满足本开关为 true 且 scheduler_jobs.json 中任务 enabled=true 才会调度。
SCHEDULER_ENABLED=false
SCHEDULER_JOBS_FILE=api_project/config/scheduler_jobs.json
